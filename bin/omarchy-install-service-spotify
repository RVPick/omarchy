#!/bin/bash

# omarchy:summary=Install Spotify.
# omarchy:args=[spotify-uri]
# omarchy:requires-sudo=true

set -e

echo "Installing Spotify..."
omarchy-pkg-add spotify

desktop_file="$HOME/.local/share/applications/spotify.desktop"

# Route the app launcher and spotify: links through omarchy-launch-spotify for native Wayland
# rendering. Mark an existing Omarchy entry with its package so removing it from Apps
# uninstalls Spotify, and leave a launcher entry the user wrote themselves alone.
if [[ ! -f $desktop_file ]]; then
  mkdir -p "$HOME/.local/share/applications"
  install -m 644 "$OMARCHY_PATH/default/applications/spotify.desktop" "$desktop_file"
  update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
elif grep -q '^Exec=.*omarchy-launch-spotify' "$desktop_file" && ! grep -q '^X-Omarchy-Package=' "$desktop_file"; then
  [[ -n $(tail -c1 "$desktop_file") ]] && echo >>"$desktop_file"
  echo 'X-Omarchy-Package=spotify' >>"$desktop_file"
fi

echo "Opening Spotify..."
omarchy-launch-spotify "$@" >/dev/null 2>&1 &

echo ""
echo "Spotify has been installed."
